":112.4,"text":"We watched the bed unravel"},{"start":112.4,"end":116.7,"text":"from the spoon."},{"start":116.7,"end":119.49,"text":"When you preach love, but still"},{"start":119.49,"end":124.29,"text":"act so crude."},{"start":124.29,"end":130.69,"text":">> Whoever said freedom was free?"},{"start":130.69,"end":132.89,"text":"There ain't no freedom without"},{"start":132.89,"end":137.59,"text":"history."},{"start":137.59,"end":138.49,"text":"And folks"},{"start":138.49,"end":142.89,"text":"who died for you and me,"},{"start":142.89,"end":145.49,"text":"so don't be an ass,"},{"start":145.49,"end":146.49,"text":"let everyone"},{"start":146.49,"end":177.49,"text":"be."},{"start":177.49,"end":180.69,"text":"So let's all pile on to the freedom"},{"start":180.69,"end":184.19,"text":"bus."},{"start":184.19,"end":190.89,"text":"It's not for some that rise, for all of us."},{"start":190.89,"end":192.59,"text":"Bring Jesus, Buddha,"},{"start":192.59,"end":197.69,"text":"or your old dog Gus."},{"start":197.69,"end":205.39,"text":"Whatever brings you joy and happiness."},{"start":205.39,"end":211.69,"text":"Whoever said freedom was free?"},{"start":211.69,"end":212.99,"text":"There ain't no freedom"},{"start":212.99,"end":213.89,"text":"without"},{"start":213.89,"end":218.79,"text":"history."},{"start":218.79,"end":219.69,"text":"And folks"},{"start":219.69,"end":224.09,"text":"who died for you and me,"},{"start":224.09,"end":226.79,"text":"so don't be an ass,"},{"start":226.79,"end":227.89,"text":"let everyone"},{"start":227.89,"end":228.69,"text":"be."}]}