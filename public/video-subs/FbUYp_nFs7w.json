{"videoId":"FbUYp_nFs7w","source":"auto","lang":"en","sentences":[{"start":5.0,"end":5.76,"text":"Traveling"},{"start":5.76,"end":7.4,"text":"the world and experiencing"},{"start":7.4,"end":8.36,"text":"new cultures"},{"start":8.36,"end":10.52,"text":"is a great way to expand"},{"start":10.52,"end":11.76,"text":"your mind."},{"start":11.76,"end":13.8,"text":"And if you can time it just right,"},{"start":13.8,"end":14.76,"text":"festivals"},{"start":14.76,"end":17.68,"text":"are the best way to integrate with locals"},{"start":17.68,"end":22.76,"text":"and learn about the area whilst having some fun, taking some memorable photos,"},{"start":22.76,"end":23.76,"text":"and creating"},{"start":23.76,"end":25.04,"text":"travel diaries"},{"start":25.04,"end":26.16,"text":"that will impress"},{"start":26.16,"end":28.24,"text":"for years to come."},{"start":28.24,"end":29.16,"text":"A festival"},{"start":29.16,"end":31.96,"text":"is usually staged by a community"},{"start":31.96,"end":32.72,"text":"celebrating"},{"start":32.72,"end":34.36,"text":"some unique aspect"},{"start":34.36,"end":35.68,"text":"of that community"},{"start":35.68,"end":37.2,"text":"and its traditions"},{"start":37.2,"end":40.64,"text":"and often set as a national holiday."},{"start":40.64,"end":45.44,"text":"Let's take a look at a few major world festivals."},{"start":45.44,"end":46.68,"text":"Undoubtedly,"},{"start":46.68,"end":48.44,"text":"one of the most famous"},{"start":48.44,"end":50.32,"text":"adrenaline-filled"},{"start":50.32,"end":52.08,"text":"festivals on the globe"},{"start":52.08,"end":53.76,"text":"takes place annually"},{"start":53.76,"end":55.04,"text":"in Pamplona,"},{"start":55.04,"end":55.84,"text":"northeastern"},{"start":55.84,"end":56.96,"text":"Spain."},{"start":56.96,"end":58.8,"text":"The Encierro,"},{"start":58.8,"end":61.64,"text":"more commonly known as the bull run,"},{"start":61.64,"end":64.96,"text":"has become a major global tourism event"},{"start":64.96,"end":68.76,"text":"held every year from July 7th to the 14th"},{"start":68.76,"end":71.28,"text":"from 8:00 a.m. every morning."},{"start":71.28,"end":74.48,"text":"Six bulls are let loose and participants"},{"start":74.48,"end":76.08,"text":"line the streets"},{"start":76.08,"end":77.2,"text":"running alongside"},{"start":77.2,"end":78.12,"text":"the animals"},{"start":78.12,"end":83.16,"text":"with the aim of steering them towards the city's bull ring for the bull fighting that"},{"start":83.16,"end":86.24,"text":"will take place later in the day."},{"start":86.24,"end":89.68,"text":"The length of the run is 875"},{"start":89.68,"end":90.6,"text":"m"},{"start":90.6,"end":92.8,"text":"and is one of the most terrifying"},{"start":92.8,"end":93.8,"text":"festivals"},{"start":93.8,"end":96.32,"text":"even to its spectators."},{"start":96.32,"end":99.08,"text":"It's not unusual for there to be injuries"},{"start":99.08,"end":100.48,"text":"during the event,"},{"start":100.48,"end":102.56,"text":"around 50 to 100"},{"start":102.56,"end":103.76,"text":"per year,"},{"start":103.76,"end":107.72,"text":"as the average speed of the herd reaches around 24"},{"start":107.72,"end":110.12,"text":"km/h."},{"start":110.12,"end":113.28,"text":"A total of 15 deaths have been recorded"},{"start":113.28,"end":115.2,"text":"since 1910"},{"start":115.2,"end":117.16,"text":"as participants have been attacked"},{"start":117.16,"end":120.36,"text":"or trampled on by the bulls."},{"start":120.36,"end":122.0,"text":"La Tomatina,"},{"start":122.0,"end":124.72,"text":"another very famous Spanish festival"},{"start":124.72,"end":126.0,"text":"held in Valencia,"},{"start":126.0,"end":127.4,"text":"eastern Spain,"},{"start":127.4,"end":128.6,"text":"is significantly"},{"start":128.6,"end":129.96,"text":"less dangerous,"},{"start":129.96,"end":132.52,"text":"but a whole lot messier."},{"start":132.52,"end":136.68,"text":"Taking place annually on the last Wednesday of August,"},{"start":136.68,"end":138.68,"text":"purely for entertainment,"},{"start":138.68,"end":139.52,"text":"participants"},{"start":139.52,"end":141.08,"text":"throw tomatoes"},{"start":141.08,"end":142.12,"text":"and basically"},{"start":142.12,"end":146.04,"text":"engage in a huge tomato fight in the town square,"},{"start":146.04,"end":148.92,"text":"usually lasting around 1 hour."},{"start":148.92,"end":150.12,"text":"It is estimated"},{"start":150.12,"end":153.0,"text":"that around 150,000"},{"start":153.0,"end":153.76,"text":"kg"},{"start":153.76,"end":154.92,"text":"of tomatoes"},{"start":154.92,"end":155.8,"text":"are thrown"},{"start":155.8,"end":157.28,"text":"each year."},{"start":157.28,"end":158.0,"text":"Rio"},{"start":158.0,"end":158.84,"text":"Carnival"},{"start":158.84,"end":159.84,"text":"in Brazil"},{"start":159.84,"end":162.68,"text":"is the largest festival in the world"},{"start":162.68,"end":165.52,"text":"with over 2 million people a day"},{"start":165.52,"end":167.04,"text":"for 6 days"},{"start":167.04,"end":169.08,"text":"on the city streets."},{"start":169.08,"end":170.04,"text":"Brazilians"},{"start":170.04,"end":172.36,"text":"are known for their party spirit"},{"start":172.36,"end":173.36,"text":"and Carnival"},{"start":173.36,"end":178.28,"text":"is the perfect opportunity to highlight this with their feathery costumes,"},{"start":178.28,"end":179.84,"text":"colorful parades,"},{"start":179.84,"end":180.72,"text":"non-stop"},{"start":180.72,"end":181.64,"text":"music,"},{"start":181.64,"end":184.4,"text":"and eclectic performances."},{"start":184.4,"end":186.84,"text":"The festival is held annually"},{"start":186.84,"end":189.76,"text":"in the week leading up to Lent."},{"start":189.76,"end":190.96,"text":"Diwali,"},{"start":190.96,"end":192.32,"text":"or the Festival"},{"start":192.32,"end":193.48,"text":"of Lights,"},{"start":193.48,"end":195.6,"text":"is the biggest Hindu festival"},{"start":195.6,"end":200.28,"text":"that is celebrated across the whole of India with excitement."},{"start":200.28,"end":202.12,"text":"The exact date changes"},{"start":202.12,"end":206.28,"text":"each year because it is based on the Hindu lunar calendar,"},{"start":206.28,"end":209.0,"text":"but typically occurs around October"},{"start":209.0,"end":210.2,"text":"to November."},{"start":210.2,"end":211.96,"text":"Diwali is a five-day"},{"start":211.96,"end":212.96,"text":"celebration"},{"start":212.96,"end":215.72,"text":"where clay lamps are lit to signify"},{"start":215.72,"end":218.48,"text":"the victory of good over evil,"},{"start":218.48,"end":219.32,"text":"light"},{"start":219.32,"end":220.76,"text":"over darkness."},{"start":220.76,"end":225.2,"text":"It is a time for friends and family to come together to celebrate"},{"start":225.2,"end":226.24,"text":"life,"},{"start":226.24,"end":228.2,"text":"feast on traditional food,"},{"start":228.2,"end":230.36,"text":"and exchange gifts."},{"start":230.36,"end":232.72,"text":"Let's finish with a somewhat"},{"start":232.72,"end":233.52,"text":"bizarre"},{"start":233.52,"end":235.32,"text":"festival held annually"},{"start":235.32,"end":236.68,"text":"in the UK."},{"start":236.68,"end":237.72,"text":"The Cooper's"},{"start":237.72,"end":240.84,"text":"Hill Cheese Rolling event in Gloucestershire,"},{"start":240.84,"end":241.64,"text":"Southwest"},{"start":241.64,"end":242.68,"text":"England."},{"start":242.68,"end":243.52,"text":"Participants"},{"start":243.52,"end":246.08,"text":"throw a 3 to 4 kg"},{"start":246.08,"end":250.4,"text":"circular double Gloucester cheese roll down an extremely"},{"start":250.4,"end":253.68,"text":"steep hill of about 200 yards"},{"start":253.68,"end":255.04,"text":"and then proceed"},{"start":255.04,"end":257.8,"text":"to chase after it to the bottom."},{"start":257.8,"end":258.88,"text":"The idea"},{"start":258.88,"end":261.04,"text":"is to catch the cheese,"},{"start":261.04,"end":263.4,"text":"but this is near impossible"},{"start":263.4,"end":265.12,"text":"as it can reach speeds"},{"start":265.12,"end":266.88,"text":"of up to 110"},{"start":266.88,"end":267.64,"text":"km"},{"start":267.64,"end":268.8,"text":"an hour."},{"start":268.8,"end":273.92,"text":"The winner is the first person over the line at the bottom of the hill."},{"start":273.92,"end":275.4,"text":"This tradition,"},{"start":275.4,"end":277.44,"text":"as comical as it sounds"},{"start":277.44,"end":278.6,"text":"and looks,"},{"start":278.6,"end":282.32,"text":"is thought to be an early form of social entertainment"},{"start":282.32,"end":284.72,"text":"which began over 600"},{"start":284.72,"end":286.16,"text":"years ago."},{"start":286.16,"end":288.32,"text":"So, whether it's cheese rolling,"},{"start":288.32,"end":289.68,"text":"street dancing,"},{"start":289.68,"end":291.16,"text":"candle lighting,"},{"start":291.16,"end":292.36,"text":"food fighting,"},{"start":292.36,"end":295.76,"text":"or just generally gathering with the locals,"},{"start":295.76,"end":296.72,"text":"festivals"},{"start":296.72,"end":297.88,"text":"are a sure-fire"},{"start":297.88,"end":300.36,"text":"and fun way to immerse yourself"},{"start":300.36,"end":301.48,"text":"in the community."}]}