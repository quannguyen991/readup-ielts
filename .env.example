# Copy sang .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# --- Client (được inline vào bundle, chỉ chứa thứ công khai được) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Người bán và kênh liên hệ — hiện ở /contact, chân trang và trang thanh toán.
# Chưa khai thì các chỗ đó im lặng, không bịa địa chỉ. Zalo là số di động VN.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_ZALO=
EXPO_PUBLIC_SELLER_NAME=
EXPO_PUBLIC_SELLER_ADDRESS=
EXPO_PUBLIC_SELLER_TAX_ID=

# Đo lường quảng cáo. Để trống thì không tải script nào, không hiện thông báo cookie.
EXPO_PUBLIC_META_PIXEL_ID=
EXPO_PUBLIC_GA4_ID=

# --- Server-only: chỉ đọc trong API route / Supabase Edge Function ---
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://codex.hungnguyen.codes/v1

# Tuỳ chọn — đổi model mà không phải sửa code
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-6

# Bí mật để gọi POST /api/assets (sinh tài nguyên theo yêu cầu). Tự đặt chuỗi ngẫu nhiên.
ASSET_ADMIN_SECRET=

# --- Ba cua AI, thu lan luot khi cua truoc hong -------------------------------
# Xem `src/services/ai/fallback.ts`. Do lai bang:
#   node scripts/bench-ai-routing.mjs scripts/bench-ai-routing.plan.json
#
# Cua 1 lam moi viec khi khoe. Model dat rieng theo tung viec vi mot proxy
# thuong co model nhanh cho viec ngan (tra tu, dich) va model manh cho viec dai
# (cham bai, sinh de).
AI_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
AI_PRIMARY_API_KEY=
WRITING_MODEL=openai/gpt-oss-120b
COACH_MODEL=openai/gpt-oss-120b
QUESTIONS_MODEL=openai/gpt-oss-120b
CHAT_MODEL=qwen/qwen3.8-27b
DEFINE_MODEL=qwen/qwen3.8-27b
TRANSLATE_MODEL=qwen/qwen3.8-27b

# Cua 2 va cua 3 chi can MOT model chung (AI_*_MODEL); muon rieng theo viec thi
# dat them WRITING_FALLBACK_MODEL, CHAT_FALLBACK_MODEL... cho cua 2.
AI_SECONDARY_BASE_URL=https://home.ai-box.vn/v1
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=deepseek-v4-flash

AI_TERTIARY_BASE_URL=https://codex.hungnguyen.codes/v1
AI_TERTIARY_API_KEY=
AI_TERTIARY_MODEL=claude-haiku-4-5-20251001
# BAT KHI proxy nuot vai `system`. Kiem bang cach gui system "chi tra loi dung mot
# tu BANANA" kem user "thu do nuoc Phap la gi": tra ve "Paris." la nuot. Proxy
# codex nuot that, va vi app dat toan bo chi dan vao vai system nen khong bat co
# nay thi cua do nhan bai luan roi tan gau thay vi cham bai.
AI_TERTIARY_FOLD_SYSTEM=true

# Ngan sach thoi gian. Ba cua x 45s vuot xa tran 60s cua ham serverless Vercel,
# nen phai co tran cho CA LUOT chu khong chi cho tung cua.
AI_TOTAL_BUDGET_MS=50000
AI_CALL_TIMEOUT_MS_QUESTIONS=15000

# Thu tu cua theo tung viec, vi du "tertiary,primary,secondary". De trong thi
# dung thu tu mac dinh primary -> secondary -> tertiary.
AI_ORDER_WRITING=
AI_ORDER_QUESTIONS=

# Sinh anh di rieng: proxy codex khong co model anh nao.
IMAGE_BASE_URL=https://home.ai-box.vn/v1
IMAGE_API_KEY=

# CHI DUNG O MAY LOCAL cho cac script sinh noi dung chay tay. Ham serverless tren
# Vercel KHONG goi toi localhost duoc — dung tro model cua app sang day.
AI_LOCAL_BASE_URL=
AI_LOCAL_API_KEY=

# --- Kho tri thuc: hoi dap tren CA KHO bai doc (LightRAG o may HoaiDuc) --------
# Xem `src/services/tutor/knowledge-base.ts` va `app/api/tutor/kb+api.ts`.
# LightRAG chay thuong truc tren HoaiDuc (LLM+embedding qua ollama local), phoi
# ra ngoai bang cloudflared tunnel. URL quick-tunnel DOI moi lan khoi dong lai;
# ban on dinh can named tunnel (dang nhap Cloudflare). KHOA phai khop LIGHTRAG_API_KEY
# dat trong .env cua server LightRAG.
KB_RAG_URL=
KB_RAG_API_KEY=
# Tran cho MOT luot hoi. Duoi 60s de Vercel khong cat giua chung.
KB_RAG_TIMEOUT_MS=55000
#
# NAP KHO: `npm run kb:ingest` dung corpus tu seed bai doc (src/data/seed) ra
# .kb/corpus.jsonl, `-- --push` thi day len LightRAG theo me 20 bai va ghi so
# tien do de chay tiep duoc cho do. Hai bien tren la cau hinh DUY NHAT no can.
#   npm run kb:ingest -- --trang-thai   # hoi chi muc da index toi dau
# Corpus dung ra phai TRUNG voi thu dang nam trong chi muc; bam da doi chieu
# 12/09/2026: 1.399 tai lieu, 9 bai khong co than bai bi bo qua co chu dinh.
